# Conflux FL — environment configuration
#
# Managed with evnx (https://evnx.dev):
#   evnx doctor          # gitignore coverage, permissions, .example sync
#   evnx diff            # what .env has that this file doesn't, and vice versa
#   evnx sync            # bring the two back into line
#   evnx scan            # refuse to let a real secret reach a commit
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is not, and
# must never contain a real value.
#
# Commented-out variables are optional: leaving them unset is different
# from setting them empty. conflux-config resolves an unset value through
# its topology/mode/builtin chain and logs where it came from (ADR 0007);
# an empty string would instead be an explicit override to "nothing".

# --- test backends -------------------------------------------------
# Where the integration tests find Redis, Postgres, and MinIO. The
# defaults in code match `docker-compose.yml`, so a developer who runs
# `docker compose up -d` needs none of these set. CI overrides them
# because its service containers use standard ports.
CONFLUX_TEST_REDIS_URL=redis://127.0.0.1:16379
CONFLUX_TEST_POSTGRES_URL=postgres://postgres:conflux@127.0.0.1:15432/conflux
CONFLUX_TEST_S3_ENDPOINT=http://127.0.0.1:19000

# --- server: deployment axes ---------------------------------------
CONFLUX_TOPOLOGY=cross_device
CONFLUX_MODE=research

# --- server: listen addresses --------------------------------------
# Both default to loopback. Binding the HTTP admin API beyond loopback
# without CONFLUX_ADMIN_TOKEN is a startup failure, not a warning.
CONFLUX_GRPC_ADDR=127.0.0.1:50051
CONFLUX_HTTP_ADDR=127.0.0.1:8080

# --- server: authentication ----------------------------------------
# Bearer token for every HTTP admin route except /health.
# CONFLUX_ADMIN_TOKEN=
# PEM public key verifying RegisterRequest.auth_token when auth = jwt.
# Required in production for cross_device/crowdsource/edge.
# CONFLUX_JWT_PUBLIC_KEY_PATH=
# mTLS material, for auth = mtls (cross_silo's default).
# CONFLUX_TLS_CERT_PATH=
# CONFLUX_TLS_KEY_PATH=
# CONFLUX_TLS_CLIENT_CA_PATH=

# --- server: durable backends --------------------------------------
# Registry, store, and epsilon-accounting persistence are selected
# independently; unset means the in-memory/disabled default. `mode =
# production` refuses to start on any of those defaults, naming the
# variable it wants -- so this section is exactly what a production
# deployment has to fill in, and a copy of this file with it all
# commented out will not start one.
#
# Registry: "redis" (then CONFLUX_REDIS_URL is required), else in-memory.
# CONFLUX_REGISTRY_BACKEND=redis
# CONFLUX_REDIS_URL=
#
# Store: "postgres" (then CONFLUX_POSTGRES_URL is required), "s3" (then
# all four CONFLUX_S3_* below are), else in-memory.
# CONFLUX_STORE_BACKEND=postgres
# CONFLUX_POSTGRES_URL=
#
# The S3 store speaks to any S3-compatible endpoint, MinIO included.
# ACCESS_KEY and SECRET_KEY are real credentials -- set them in `.env`,
# which is gitignored and what `evnx scan` guards, never here.
# CONFLUX_S3_ENDPOINT=
# CONFLUX_S3_BUCKET=
# CONFLUX_S3_ACCESS_KEY=
# CONFLUX_S3_SECRET_KEY=
#
# Epsilon accounting persistence: exactly "true" enables it, reusing
# CONFLUX_POSTGRES_URL. Left disabled, the accountant starts every
# process at epsilon = 0, so a restart silently re-spends a budget the
# experiment already spent (ADR 0006, and the gap Phase 7d closed).
# CONFLUX_ACCOUNTING_PERSISTENCE=true

# --- experiment tuning ---------------------------------------------
CONFLUX_AGGREGATOR=fedavg
CONFLUX_SELECTOR=uniform_random
CONFLUX_ROBUST_BYZANTINE_FRACTION=0.2
# Centered Clipping's tau. MUST be tuned to your model's weight scale:
# the builtin 1.0 measured WORSE than no defense on a real 50,890-
# parameter model. See docs/research/ section 5.13.
CONFLUX_CLIP_RADIUS=1.0
# The `optimization` family's server optimizer (fedadagrad/fedadam/
# fedyogi — Reddi et al., 2021). `η` is the parameter that paper sweeps
# per task and deliberately publishes no default for, so the builtin 1.0
# is a starting point, not a recommendation. `τ` at 1e-3 *is* the paper's
# own value. Both ignored by every aggregator outside that family.
# CONFLUX_SERVER_LEARNING_RATE=1.0
# CONFLUX_SERVER_TAU=0.001
# FedAvgM's server momentum. Unlike the learning rate above, 0.9 IS a
# real default -- it sits inside the paper's own sweep. But that sweep is
# wide and the paper's finding is that momentum matters more the less
# identical your clients' data is, so tune it on a real non-IID
# deployment. 0.0 recovers plain FedAvg exactly.
# CONFLUX_SERVER_MOMENTUM=0.9
# q-FedAvg's fairness exponent. 0.0 IS exactly FedAvg -- selecting
# `qfedavg` without choosing a q should not silently apply a fairness
# trade nobody asked for. Larger q weights high-loss clients up,
# flattening the accuracy distribution at some cost to its mean and, less
# obviously, to convergence speed. Needs clients that report
# `local_loss`; without it this behaves as FedAvg.
# CONFLUX_FAIRNESS_Q=0.0

# SCAFFOLD's client population N (aggregator = "scaffold"). Builtin
# fallback 1.
#
# This is the TOTAL number of clients in the deployment, not the number
# sampled into a round. SCAFFOLD damps its control-variate update by 1/N
# precisely because only |S| of the N clients contributed evidence this
# round; substituting the batch size would turn that damping off and
# change the method rather than merely rescaling it. Nothing on the
# server can infer N — a batch only ever shows |S| — so it must be
# stated here.
# CONFLUX_SCAFFOLD_NUM_CLIENTS=1
# q-FedAvg's Lipschitz estimate L. A placeholder like CONFLUX_CLIP_RADIUS:
# the paper estimates it by grid search at q=0, which the server cannot
# do because it never sees a loss surface. Inverse of the client learning
# rate, in the paper's framing.
# CONFLUX_SERVER_LIPSCHITZ=1.0
# CONFLUX_QUORUM=
CONFLUX_ROUND_TIMEOUT_SECS=300
# Reputation gating. The filter is off by default and belongs to neither
# config axis; the threshold it applies once on is topology-owned, so
# leaving it unset is usually right -- cross_silo 0.0, cross_device 0.3,
# crowdsource 0.6, edge 0.3.
# CONFLUX_REPUTATION_FILTER_ENABLED=false
# CONFLUX_MIN_REPUTATION_SCORE=
# Largest reassembled update the transport accepts from one client, in
# bytes. A trust-boundary bound, not a tuning knob: gRPC's own limit is
# per message, so without this a client that never stops streaming grows
# the server's heap without bound. Builtin 256 MiB (268435456), which is
# far above any plausible model -- a 50,890-parameter f32 model is
# ~200 KiB. Raise it only if your model genuinely exceeds it.
# CONFLUX_MAX_UPDATE_BYTES=268435456

# --- privacy --------------------------------------------------------
CONFLUX_PRIVACY_MECHANISM=gaussian_clipping
CONFLUX_CLIP_NORM=1.0
CONFLUX_NOISE_MULTIPLIER=1.0
CONFLUX_CLIENT_SIDE_PRIVACY_TRANSFORM=false

# --- trusted-reference sidecar (ADR 0011, optional) ------------------
# Only relevant when `CONFLUX_AGGREGATOR` names a `trusted`-family method
# (`fltrust` today). Every other deployment leaves this whole section
# commented out, runs no sidecar, and opens no connection.
#
# Server side: where to reach the sidecar. `conflux-server` refuses to
# start if the configured aggregator needs one and this is unset, and
# warns (without connecting) if this is set and the aggregator does not.
# CONFLUX_TRUSTED_REFERENCE_ADDR=http://127.0.0.1:50100

# Sidecar side: read by the `conflux-trusted-reference` binary itself,
# not by the server.
#
# The trusted root dataset. **Required** — the sidecar has no default,
# because starting one with an invented dataset would serve a reference
# nobody chose, and FLTrust's entire guarantee is only as good as this
# file. One example per line, comma-separated, target last:
# `1.0,2.0,5.0` is features [1.0, 2.0] and target 5.0.
# CONFLUX_TRUSTED_DATASET_PATH=/etc/conflux/root-dataset.csv
# CONFLUX_SIDECAR_ADDR=127.0.0.1:50100
# How hard the sidecar trains. FLTrust assumes the server's own effort is
# comparable to a client's and does not check it — a reference trained far
# less than the clients were still produces a valid vector, it just points
# less far, quietly weakening every trust score computed against it.
# CONFLUX_TRUSTED_LEARNING_RATE=0.05
# CONFLUX_TRUSTED_STEPS=200

# --- node ------------------------------------------------------------
CONFLUX_SERVER_ADDR=http://127.0.0.1:50051
CONFLUX_CLIENT_ID=node-1
CONFLUX_LOCAL_ADDR=127.0.0.1:47100
CONFLUX_CONNECTION_MODE=pull
CONFLUX_CLIENT_APP_KIND=stub
# CONFLUX_ALLOW_STUB_CLIENT=
# Seeds conflux-node's client-side DP noise so a run reproduces. Unset
# means nondeterministic noise, which is what a real deployment wants;
# set it for experiments you need to repeat. Must parse as an integer --
# conflux-node panics on a malformed value rather than ignoring it.
# CONFLUX_SEED_VALUE=

# --- optional --------------------------------------------------------
# A flat TOML file of experiment-level overrides (Phase 20).
# CONFLUX_EXPERIMENT_CONFIG_PATH=
CONFLUX_INITIAL_WEIGHTS_DIM=4
